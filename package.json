{
  "name": "@baezel/data-module",
  "version": "1.0.0-dev.0",
  "description": "Pluggable NestJS database module with optional Prisma and TypeORM connectors",
  "keywords": [
    "nestjs",
    "database",
    "prisma",
    "typeorm",
    "connector",
    "repository",
    "module",
    "typescript"
  ],
  "homepage": "https://github.com/Baezel-Interactive/data-module#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baezel-Interactive/data-module.git"
  },
  "bugs": {
    "url": "https://github.com/Baezel-Interactive/data-module/issues"
  },
  "author": "Harsh Rawat",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "baezel-data": "dist/cli/index.js"
  },
  "sideEffects": [
    "dist/runtime/node-guard.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mongo": {
      "types": "./dist/mongo/index.d.ts",
      "default": "./dist/mongo/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "default": "./dist/prisma/index.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm/index.d.ts",
      "default": "./dist/typeorm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify:gate",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:types": "vitest --typecheck --run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,mjs}\"",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs}\"",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "check:no-tla": "node scripts/check-package.mjs no-tla",
    "smoke:cjs": "node scripts/check-package.mjs smoke",
    "check:guard": "node scripts/check-package.mjs guard",
    "audit": "npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.json",
    "verify:gate": "npm run build && npm run publint && npm run attw && npm run check:no-tla && npm run smoke:cjs && npm run check:guard",
    "verify:fast": "npm run verify:gate && npm run typecheck && npm run lint && npm test && npm run test:types",
    "verify": "npm run verify:fast && npm run test:integration && npm run audit && npm run sbom"
  },
  "dependencies": {
    "cockatiel": "^4.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^6.0.0 || ^7.0.0",
    "mongodb": ">=6.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "typeorm": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/core": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.6.2",
    "@nestjs/testing": "^12.6.2",
    "@opentelemetry/api": "^1.10.0",
    "@swc/core": "^1.16.22",
    "@testcontainers/mongodb": "^12.2.2",
    "@testcontainers/mysql": "^12.2.2",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "mongodb": "^7.9.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "testcontainers": "^12.2.2",
    "typeorm": "^1.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
