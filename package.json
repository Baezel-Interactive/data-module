{
  "name": "@baezel/data-module",
  "version": "0.0.2",
  "description": "Pluggable NestJS database module with optional Prisma and TypeORM connectors",
  "keywords": [
    "nestjs",
    "database",
    "prisma",
    "typeorm",
    "connector",
    "repository",
    "module",
    "typescript"
  ],
  "homepage": "https://github.com/Baezel-Interactive/data-module#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baezel-Interactive/data-module.git"
  },
  "bugs": {
    "url": "https://github.com/Baezel-Interactive/data-module/issues"
  },
  "author": "Harsh Rawat",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "require": "./dist/prisma/index.js",
      "default": "./dist/prisma/index.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm/index.d.ts",
      "require": "./dist/typeorm/index.js",
      "default": "./dist/typeorm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\""
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "typeorm": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.6.2",
    "@nestjs/testing": "^12.6.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.10",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.15",
    "typeorm": "^1.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
